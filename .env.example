# Assembly — Environment Configuration
# Copy this file to .env and fill in your values

# ────────────────────────────────────────────
# Application
# ────────────────────────────────────────────
APP_NAME=Assembly
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ────────────────────────────────────────────
# Security
# ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ────────────────────────────────────────────
# Database (SQLite for MVP)
# ────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./assembly.db

# ────────────────────────────────────────────
# AI Provider API Keys
# ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key
CEREBRAS_API_KEY=csk_your-cerebras-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# ────────────────────────────────────────────
# Default Models
# ────────────────────────────────────────────
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
CEREBRAS_DEFAULT_MODEL=llama-3.3-70b
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free
HUGGINGFACE_DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ────────────────────────────────────────────
# Research / Web Search (Tavily)
# ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key

# ────────────────────────────────────────────
# Budget Defaults
# ────────────────────────────────────────────
MAX_TOKENS_PER_EXECUTION=100000
MAX_SEARCHES_PER_EXECUTION=20

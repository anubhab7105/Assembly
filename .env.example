# Assembly — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# Web mode is stateless: no database, no accounts. Desktop/dev keep a
# local SQLite file managed by the app (no DATABASE_URL needed).

# ────────────────────────────────────────────
# Application
# ────────────────────────────────────────────
APP_NAME=Assembly
APP_ENV=development                # production | development
DEBUG=true                         # false in production
HOST=0.0.0.0
PORT=8000
APP_MODE=dev                       # web | desktop | dev

# ────────────────────────────────────────────
# Frontend / CORS allow-list (web)
# ────────────────────────────────────────────
# Single URL plus optional comma-separated list. Empty = same-origin only.
FRONTEND_URL=
CORS_ALLOW_LIST=

# ────────────────────────────────────────────
# Stateless run registry + abuse protection (web)
# ────────────────────────────────────────────
RUN_TTL_SECONDS=3600
MAX_CONCURRENT_RUNS=20
SSE_HEARTBEAT_SECONDS=15
MAX_BODY_BYTES=1048576
MAX_QUESTION_CHARS=2000
RATE_LIMIT_RUN_PER_MIN_PER_IP=5
RATE_LIMIT_PREFLIGHT_PER_MIN_PER_IP=10
RATE_LIMIT_KEY_TEST_PER_MIN_PER_IP=10

# ────────────────────────────────────────────
# Quota salt (fingerprinting only, never a JWT key)
# ────────────────────────────────────────────
QUOTA_SALT=

# ────────────────────────────────────────────
# AI Provider API Keys (dev mode only; web uses per-request keys,
# desktop uses the OS keyring — never .env in production)
# ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key
CEREBRAS_API_KEY=csk-your-cerebras-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# NOTE: model ids, families, roles, and limits live in models.yaml (repo root).

# ────────────────────────────────────────────
# Research / Web Search (Tavily)
# ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key

# ────────────────────────────────────────────
# Budget Defaults
# ────────────────────────────────────────────
MAX_TOKENS_PER_EXECUTION=100000
MAX_SEARCHES_PER_EXECUTION=20

# ────────────────────────────────────────────
# Pre-send token reserve (quota leases)
# ────────────────────────────────────────────
# Reasoning/thinking tokens bill against per-minute token windows but are
# only reported after the call, so leases reserve this average up front.
TOKENS_REASONING_RESERVE=700

# ────────────────────────────────────────────
# Per-stage measured token usage (capacity math + worst-case preflight)
# ────────────────────────────────────────────
# Measured on a real 5-minute-tier run (n=1 — re-measure after the
# benchmark). Averages convert tpm/tpd windows into call counts; p90
# drives worst-case preflight. Re-measure with scripts/measure_tokens.py.
TOKEN_STATS_SOURCE_RUN_ID=debug-5m-001
TOKEN_STATS_SOURCE_DATE=2026-10-09
TOKENS_PLANNER_AVG=398
TOKENS_PLANNER_P90=398
TOKENS_SOLVE_AVG=1126
TOKENS_SOLVE_P90=1368
TOKENS_DEBATE_AVG=1484
TOKENS_DEBATE_P90=2078
TOKENS_ADVERSARIAL_AVG=1484
TOKENS_ADVERSARIAL_P90=2078
TOKENS_SYNTHESIS_AVG=2245
TOKENS_SYNTHESIS_P90=2245

# ────────────────────────────────────────────
# Consensus scoring (docs/WORKFLOW.md section 6)
# ────────────────────────────────────────────
# Tune on the benchmark; never hard-code elsewhere.
CONSENSUS_W_AGREEMENT=0.30
CONSENSUS_W_CONFIDENCE=0.20
CONSENSUS_W_EVIDENCE=0.25
CONSENSUS_W_CONTRADICTION=0.15
CONSENSUS_W_STABILITY=0.10
CONSENSUS_FINALIZE_THRESHOLD=0.85
CONSENSUS_NEW_INFO_THRESHOLD=0.15
CONSENSUS_CONTRADICTION_LIMIT=0.20
CONSENSUS_EVIDENCE_FLOOR=0.50

# ────────────────────────────────────────────
# Desktop token (desktop mode only)
# ────────────────────────────────────────────
# The backend generates a random token per launch and prints it
# (ASSEMBLY_TOKEN=...) for the desktop shell. Set this only to pin a
# fixed token in controlled local setups — never in production.
# DESKTOP_TOKEN=

# ────────────────────────────────────────────
# Frontend (Next.js, frontend/app/.env.local)
# ────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_APP_MODE=dev              # web | desktop | dev

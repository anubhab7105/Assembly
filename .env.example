# Assembly — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# Web mode is stateless: no database, no accounts. Desktop/dev keep a
# local SQLite file managed by the app (no DATABASE_URL needed).

# ────────────────────────────────────────────
# Application
# ────────────────────────────────────────────
APP_NAME=Assembly
APP_ENV=development                # production | development
DEBUG=true                         # false in production
HOST=0.0.0.0
PORT=8000
APP_MODE=dev                       # web | desktop | dev

# ────────────────────────────────────────────
# Frontend / CORS allow-list (web)
# ────────────────────────────────────────────
# Single URL plus optional comma-separated list. Empty = same-origin only.
FRONTEND_URL=
CORS_ALLOW_LIST=

# ────────────────────────────────────────────
# Stateless run registry + abuse protection (web)
# ────────────────────────────────────────────
RUN_TTL_SECONDS=3600
MAX_CONCURRENT_RUNS=20
SSE_HEARTBEAT_SECONDS=15
MAX_BODY_BYTES=1048576
MAX_QUESTION_CHARS=2000
RATE_LIMIT_RUN_PER_MIN_PER_IP=5
RATE_LIMIT_PREFLIGHT_PER_MIN_PER_IP=10
RATE_LIMIT_KEY_TEST_PER_MIN_PER_IP=10

# ────────────────────────────────────────────
# Quota salt (fingerprinting only, never a JWT key)
# ────────────────────────────────────────────
QUOTA_SALT=

# ────────────────────────────────────────────
# AI Provider API Keys (dev mode only; web uses per-request keys,
# desktop uses the OS keyring — never .env in production)
# ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key
CEREBRAS_API_KEY=csk-your-cerebras-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# NOTE: model ids, families, roles, and limits live in models.yaml (repo root).

# ────────────────────────────────────────────
# Research / Web Search (Tavily)
# ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key

# ────────────────────────────────────────────
# Budget Defaults
# ────────────────────────────────────────────
MAX_TOKENS_PER_EXECUTION=100000
MAX_SEARCHES_PER_EXECUTION=20

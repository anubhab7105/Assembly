# Assembly — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# For production (Render), set these as Environment Variables
# in the Render dashboard instead of using a .env file.

# ────────────────────────────────────────────
# Application
# ────────────────────────────────────────────
APP_NAME=Assembly
APP_ENV=development                # production | development
DEBUG=true                         # false in production
HOST=0.0.0.0
PORT=8000

# ────────────────────────────────────────────
# Frontend URL (production only)
# ────────────────────────────────────────────
# Set this to your Vercel frontend URL in production.
# When set, CORS locks down to this origin only.
# Leave empty for local dev (allows all origins).
FRONTEND_URL=

# ────────────────────────────────────────────
# Security
# ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ────────────────────────────────────────────
# Database
# ────────────────────────────────────────────
# Local dev → SQLite (no setup needed):
DATABASE_URL=sqlite:///./assembly.db
#
# Production → Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# NOTE: SQLAlchemy requires "postgresql://" not "postgres://"
#       The app auto-fixes this, but use the correct prefix anyway.

# ────────────────────────────────────────────
# AI Provider API Keys
# ────────────────────────────────────────────
# At least 3 providers must be configured for multi-agent consensus.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key
CEREBRAS_API_KEY=csk-your-cerebras-api-key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# ────────────────────────────────────────────
# Default Models
# ────────────────────────────────────────────
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
HUGGINGFACE_DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ────────────────────────────────────────────
# Research / Web Search (Tavily)
# ────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key

# ────────────────────────────────────────────
# Budget Defaults
# ────────────────────────────────────────────
MAX_TOKENS_PER_EXECUTION=100000
MAX_SEARCHES_PER_EXECUTION=20

